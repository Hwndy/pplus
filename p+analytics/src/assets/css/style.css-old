@font-face {
    font-family: 'Outfit';
    src: url('../fonts/Outfit-Thin.woff2') format('woff2'),
        url('../fonts/Outfit-Thin.woff') format('woff');
    font-weight: 100;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Outfit';
    src: url('../fonts/Outfit-Bold.woff2') format('woff2'),
        url('../fonts/Outfit-Bold.woff') format('woff');
    font-weight: bold;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Outfit';
    src: url('../fonts/Outfit-Black.woff2') format('woff2'),
        url('../fonts/Outfit-Black.woff') format('woff');
    font-weight: 900;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Outfit';
    src: url('../fonts/Outfit-Regular.woff2') format('woff2'),
        url('../fonts/Outfit-Regular.woff') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Outfit';
    src: url('../fonts/Outfit-Light.woff2') format('woff2'),
        url('../fonts/Outfit-Light.woff') format('woff');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Outfit';
    src: url('../fonts/Outfit-SemiBold.woff2') format('woff2'),
        url('../fonts/Outfit-SemiBold.woff') format('woff');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Outfit';
    src: url('../fonts/Outfit-Medium.woff2') format('woff2'),
        url('../fonts/Outfit-Medium.woff') format('woff');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Outfit';
    src: url('../fonts/Outfit-ExtraLight.woff2') format('woff2'),
        url('../fonts/Outfit-ExtraLight.woff') format('woff');
    font-weight: 200;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Outfit';
    src: url('../fonts/Outfit-ExtraBold.woff2') format('woff2'),
        url('../fonts/Outfit-ExtraBold.woff') format('woff');
    font-weight: bold;
    font-style: normal;
    font-display: swap;
}

body, h1, h2, h3, h4, h5, h6, p, a, span, table, td, th, strong{font-family: Outfit;}
.signup-login-main .bg-login-image {
    background-color: #f2f2f9;
}
.signup-login-main h1 {
    font-style: normal;
    font-weight: 400;
    font-size: 30px;
    line-height: 38px;
    text-transform: capitalize;
    color: #262F40!important;
    opacity: 0.9;
    margin-bottom: 2px!important;
}
.signup-login-main p {
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: #4F6880;
        margin-bottom: 8px;
}
.signup-login-main label {
    font-style: normal;
    font-weight: 400;
    font-size: 17px;
    line-height: 21px;
    color: #262F40;
        margin-bottom: 0;
}
.signup-login-main form.user .form-control-user {
    border-radius: 5px;
    padding: 1.5rem 1rem;
    background: #F5F7F9;
    font-style: normal;
    font-weight: 300;
    font-size: 18px;
    line-height: 23px;
    display: flex;
    align-items: center;
    color: #262F40;
    border: 0px;
}
.signup-login-main form.user .form-control-user:-internal-autofill-selected{    background: #F5F7F9;}

.signup-login-main .form-group:first-child {
    margin-bottom: 9px;
}
.custom-control a.small {
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: #010081;
}
.rem-forgot{display: flow-root;    margin-bottom: 30px;}
.rem-forgot .rm-left {
    float: left;
}
.rem-forgot .rm-right {
    float: right;
}
.signup-login-main form.user .form-control-user:focus, .signup-login-main a.btn:focus {
    outline: none;
    box-shadow: none!important;
    border: 0px;
}
.signup-login-main .btn.btn-primary.btn-user.btn-block {
 background: #010081;
    border-radius: 5px;
    height: 46px;
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: #FFFFFF;
}
.signup-login-main .btn.btn-google.btn-user.btn-block {
    background: transparent;
    border: 1px solid #4F6880;
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: #262F40;
    border-radius: 5px;
    margin-top: 10px;
        height: 46px;
}
.signup-login-main .btn.btn-google img {
    margin-right: 8px;
}
.p-5.padd-top {
    padding-top: 250px!important;
      padding-bottom: 250px!important;
}
body{background-color: #fff;}
.padd-zero {
    padding: 0;
}
.signup-login-main .row {
    margin: 0;
}


/************Sidevbar Menu****************/
@media(min-width: 768px){
   ul#accordionSidebar {
    background: #fff;
    width: 290px!important;
} 
#accordionSidebar .nav-item .nav-link {
    color: #000;
align-items: center;
    display: flex;
width: 290px;
padding-right: 0;
}
#accordionSidebar .nav-item a.nav-link.active {
    background: #010081;
    border-radius: 0px 50px 50px 0px;
    color: #fff;
 width: 290px;
}
}
ul#accordionSidebar {
    background: #fff;
}
/*#accordionSidebar .nav-item .nav-link {
    color: #000;
align-items: center;
    display: flex;
width: 290px;
padding-right: 0;
}*/
#accordionSidebar .nav-item .nav-link i {
    color: #4F6880;
    font-size: 18px;
    margin-right: 14px;
}
#accordionSidebar .nav-item .nav-link img {
    margin-right: 14px;
}
#accordionSidebar .nav-item .nav-link[data-toggle=collapse]::after {
    color: #505B71;
    position: absolute;
    right: 22px;
    margin-top: 5px;
}
#accordionSidebar .nav-item a.nav-link.active {
    background: #010081;
    border-radius: 0px 50px 50px 0px;
    color: #fff;
}
#accordionSidebar .nav-item a.nav-link.active span {
    color: #fff;
}
.nac-space {
    padding-top: 44px;
}
.sidebar .sidebar-brand {
    padding-bottom: 0;
}
#accordionSidebar .nav-item a.nav-link.active img.img-active {
    display: block;
}
#accordionSidebar .nav-item .nav-link img.img-active, #accordionSidebar .nav-item a.nav-link.active img.img-nonactive {
    display: none;
}
@media (min-width: 768px){
.sidebar .nav-item .nav-link span {
    margin-right: 26px;
}
.sidebar .nav-item .nav-link span {
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    line-height: 23px;
    display: flex;
    align-items: center;
    color: #4F6880;
}
.sidebar .sidebar-brand .sidebar-brand-text {
    display: inline;
    margin-left: -24px!important;
}
}
.sub-nav a.collapse-item.sub-active {
    font-style: normal;
    font-weight: 400!important;
    font-size: 18px;
    line-height: 23px;
    display: flex!important;
    align-items: center;
    color: #010081!important;
} 
.sub-nav a.collapse-item {
    font-style: normal;
    font-weight: 400!important;
    font-size: 18px;
    line-height: 23px;
    display: flex!important;
    align-items: center;
    color: #4F6880!important;
        padding-bottom: 0!important;
}
.sub-nav {
    background: #F0F2FF;
    padding-top: 0!important;
}
.sub-nav a.collapse-item:hover {
    background: transparent!important;
}
.sub-nav .fa-minus {
    font-size: 10px;
    margin-right: 4px;
}
.export-item a {
    background: #010081;
    padding: 6px 19px;
    border-radius: 5px;
    color: #fff;
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    text-align: center;
}
li.export-item {
    display: flex;
    flex-direction: row;
    align-items: center;
}
li.export-item a img {
    margin-right: 5px;
}
.navbar-search .form-control {
    padding: 0.61rem 0.75rem;
    border-radius: 10px!important;
}
.form-control:focus, .btn-primary.focus, .btn-primary:focus {
    outline: 0;
    box-shadow:none!important;
}
.btn-primary:not(:disabled):not(.disabled):active{background-color: transparent!important;border:0px!important;}
input.form-control::placeholder {
    font-style: normal;
    font-weight: 300;
    font-size: 16px;
    line-height: 21px;
    color: #262F40;
}
.navbar-search button.btn.btn-primary {
    background: transparent;
    border: 0px;
    position: absolute;
    right: 0;
    z-index: 99;
}
.user-sec a#userDropdown {
    display: block;
}
.user-sec a#userDropdown img.img-profile {
    float: left;
}
#wrapper #content-wrapper #content {
    flex: inherit !important;
  }

  .card.row.card-body {
    margin: 0;
  }
  footer.sticky-footer {
    padding: 2rem 0;

  }

  .w-5.h-5 {
    width: 20px;
  }